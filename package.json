{
  "name": "agent-office",
  "productName": "Agent Office",
  "version": "0.5.0",
  "description": "A live 3D office showing every AI agent running on your machine, with teams you can build from them",
  "main": "src/main/main.js",
  "author": "Melih Dikmen",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/renderer/main.js --bundle --format=iife --target=chrome130 --outfile=out/renderer.js --log-level=warning",
    "start": "npm run build && electron .",
    "check": "for f in src/main/*.js; do node --check $f || exit 1; done && npm run build && node --test \"test/*.test.js\"",
    "shot": "npm run build && electron scripts/shot.js",
    "dist": "npm run build && electron-builder --mac",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "com.melihdikmen.agentoffice",
    "icon": "build/icon.png",
    "files": [
      "src/**/*",
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Development",
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  }
}
